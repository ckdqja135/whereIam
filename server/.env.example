# 서버 포트 (외부에 직접 노출하지 말고 Caddy/Nginx 뒤에 둘 것)
PORT=4000
# 바인딩 주소. 기본 127.0.0.1 (Caddy/Nginx 뒤에서만 접근). 프록시 없이 IP로 직접 테스트할 때만 0.0.0.0
HOST=127.0.0.1
# 허용할 프론트 origin (쉼표로 구분)
CORS_ORIGINS=https://whereiam.vercel.app,http://localhost:3000
# SQLite DB 파일 경로 (디렉터리가 없으면 자동 생성)
DB_PATH=./data/whereiam.db
# 프론트(Vercel) 프록시 전용 공유 비밀키. 설정하면 /health 외 모든 요청에 X-Proxy-Secret 헤더가 필요하다.
# Vercel 의 BACKEND_PROXY_SECRET 과 같은 값. 생성 예: openssl rand -hex 32
PROXY_SECRET=
# 카카오 REST API 키 (4지선다 퀴즈 문제 풀: 로드뷰 좌표 → 시·도/시·군·구 확인, 지하철역 퀴즈: 전국 지하철역 목록. 서버에서만 쓴다)
# Kakao Developers > 내 애플리케이션 > 앱 키 > "REST API 키" (JavaScript 키 아님). 프론트(Vercel)의 KAKAO_REST_API_KEY 와 같은 값이면 된다.
# 비어 있으면 문제 풀에 보탤 수 없다 (POST /quiz/pool 이 503, 지하철역 목록도 못 모음)
KAKAO_REST_API_KEY=
# 카카오 API 주소. 기본값 그대로 두고, 테스트에서만 가짜 서버 주소로 바꾼다
KAKAO_API_BASE=https://dapi.kakao.com
# 지하철역 퀴즈: 역 앞 로드뷰 사진에 역 이름이 보이면(OCR) 그 문제를 뺀다. 기본 켜짐.
# 처음 한 번 한국어 글자 데이터(약 2MB)를 DB 폴더의 tessdata/ 에 내려받는다. off 면 확인 없이 문제로 낸다
# STATION_SIGN_CHECK=on

# 프론트(Next.js) 환경 변수. 로컬은 .env.local 로 복사해서 사용, 배포는 Vercel 프로젝트 설정에 등록.

# 사이트 주소 (공유 미리보기 og:image 절대 URL 기준). 비우면 https://where-iam.vercel.app
NEXT_PUBLIC_SITE_URL=

# 카카오맵 JavaScript 키 (브라우저 노출)
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 카카오 REST API 키 (서버 전용, /api/kakao/search)
KAKAO_REST_API_KEY=

# 백엔드(server/) 호출 방식
# - 프록시 방식(권장): 브라우저는 /api/backend 만 호출하고 Vercel 서버가 BACKEND_URL 로 대신 요청
#   → 백엔드가 HTTP(IP:포트)여도 되고 도메인/인증서가 필요 없다
# - 직접 호출: NEXT_PUBLIC_API_URL 에 https:// 주소를 넣으면 브라우저가 직접 호출 (HTTPS 필수)
# 비어 있으면 챌린지 기능이 꺼진다.
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_URL=http://127.0.0.1:4000
# server/.env 의 PROXY_SECRET 과 같은 값 (프록시 방식일 때)
BACKEND_PROXY_SECRET=
